# Optional. Leave blank to use extractive evidence-only mode.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local embedding and index configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=data/chroma
RAW_PDF_DIR=data/raw
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Chroma L2 distance; lower is closer. Tune using your own evaluation set.
MAX_DISTANCE=1.35
MAX_FILE_MB=25
